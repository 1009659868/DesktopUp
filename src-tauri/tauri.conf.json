{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop-Up",
  "version": "0.0.1",
  "identifier": "com.allmight.desktopup",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Desktop-Up · A0 Demo",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true
      },
      {
        "label": "poster",
        "title": "",
        "url": "poster.html",
        "x": 0,
        "y": 0,
        "width": 420,
        "height": 1368,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "focusable": true,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Style and organize game shortcuts as desktop posters",
    "longDescription": "Desktop-Up is a lightweight Windows desktop poster launcher for organized, customizable game collections.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
