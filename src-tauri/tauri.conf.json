{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopUp",
  "mainBinaryName": "DesktopUp",
  "version": "0.0.1",
  "identifier": "com.allmight.desktopup",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "poster",
        "title": "",
        "url": "poster.html",
        "x": 72,
        "y": 154,
        "width": 490,
        "height": 392,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnBottom": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "category": "Utility",
    "shortDescription": "Style and organize game shortcuts as desktop posters",
    "longDescription": "Desktop-Up is a lightweight Windows desktop poster launcher for organized, customizable game collections.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi"
      }
    }
  }
}
