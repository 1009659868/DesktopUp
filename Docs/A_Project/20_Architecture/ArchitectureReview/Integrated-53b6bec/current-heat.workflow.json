  "cards": [
    {
      "dot": "emerald",
      "title": "唯一状态所有者",
      "items": [
        "Session 持有缓冲、有效提案、派生文档与档位；不持有窗口或存储。",
        "窗口仍负责交互安全点、调度与同帧发布，作者配置不被热度覆盖。"
      ]
    },
    {
      "dot": "amber",
      "title": "现有机制 ≠ 完整热度功能",
      "items": [
        "当前只验证提案接入；成功事实消费和实际评分尚未制作。",
        "未来“下次展开／明确刷新”发布节奏不能仅用安全点代替。"
      ]
    }
  ]
