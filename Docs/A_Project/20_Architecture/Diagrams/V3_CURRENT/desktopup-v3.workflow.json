        "note": "从鼠标采样到视觉、区域、像素和输入岛的一次提交。"
      },
      {
        "id": "desktop-pass-through",
        "label": "桌面穿透",
        "focus": ["pointer_sample", "sparse_route", "explorer_receives"],
        "note": "不属于交互岛的空白继续交给 Explorer 图标层。"
      },
      {
        "id": "failure-boundary",
        "label": "拒绝与回滚",
        "focus": ["permission_gate", "ignored_intent", "atomic_submit", "rollback_frame"],
        "note": "锁定/模式拒绝不改变状态；提交失败恢复上一稳定帧。"
      }
    ]
  },
  "lanes": [
    {"id": "user_shell", "label": "用户 / Windows Shell"},
    {"id": "input_host", "label": "InputIsland / DesktopHost"},
    {"id": "application", "label": "Application / Domain"},
    {"id": "visual_state", "label": "Poster Visual / State"},
    {"id": "exceptions", "label": "拒绝与恢复", "variant": "exception"}
  ],
  "phases": [
    {"id": "sample", "label": "采样", "fromCol": 0, "toCol": 0},
    {"id": "route", "label": "路由", "fromCol": 1, "toCol": 2},
    {"id": "decide", "label": "判定与准备", "fromCol": 3, "toCol": 4, "variant": "emphasis"},
    {"id": "commit", "label": "协调提交", "fromCol": 5, "toCol": 5, "variant": "security"}
  ],
  "groups": [
    {"id": "protected_input", "label": "受保护交互路径", "lane": "input_host", "fromCol": 1, "toCol": 2, "variant": "emphasis"},
    {"id": "failure_path", "label": "无副作用失败路径", "lane": "exceptions", "fromCol": 3, "toCol": 5, "variant": "security"}
  ],
  "mainPath": ["pointer_sample", "sparse_route", "input_intent", "permission_gate", "prepare_frame", "atomic_submit", "geometry_commit"],
  "semanticChecks": {
    "allowedRoots": ["pointer_sample"],
    "allowedTerminals": ["sqlite_state", "explorer_receives", "ignored_intent"],
    "requiredPaths": [
      {"from": "pointer_sample", "to": "geometry_commit"},
      {"from": "sparse_route", "to": "explorer_receives"},
      {"from": "permission_gate", "to": "ignored_intent"},
      {"from": "atomic_submit", "to": "rollback_frame"}
    ]
  },
  "nodes": [
    {"id": "pointer_sample", "lane": "user_shell", "col": 0, "type": "external", "label": "Pointer / Wheel", "sublabel": "drag · resize · button · item", "width": 168},
    {"id": "sparse_route", "lane": "input_host", "col": 1, "type": "backend", "label": "Sparse Hit Test", "sublabel": "HRGN + layout revision", "tag": "CURRENT", "width": 158},
    {"id": "input_intent", "lane": "application", "col": 2, "type": "messagebus", "label": "Poster Intent", "sublabel": "target + gesture + delta", "width": 152},
    {"id": "permission_gate", "lane": "application", "col": 3, "type": "security", "label": "Mode Permission", "sublabel": "USING · EDITING · LOCKED", "width": 160},
    {"id": "prepare_frame", "lane": "visual_state", "col": 4, "type": "backend", "label": "Prepare Frame", "sublabel": "bounds · region · layout", "width": 160},
    {"id": "atomic_submit", "lane": "input_host", "col": 5, "type": "backend", "label": "Cluster Apply", "sublabel": "visual → bounds → input", "tag": "CURRENT", "width": 160},
    {"id": "geometry_commit", "lane": "application", "col": 5, "type": "messagebus", "label": "Geometry Commit", "sublabel": "once on pointer release", "tag": "CURRENT EVENT", "width": 164},
    {"id": "sqlite_state", "lane": "visual_state", "col": 5, "type": "database", "label": "SQLite StateStore", "sublabel": "revision + CAS + fallback", "tag": "V3-04 PLANNED", "width": 170},
    {"id": "explorer_receives", "lane": "user_shell", "col": 2, "type": "external", "label": "Explorer Receives", "sublabel": "blank area → Explorer", "width": 180},
    {"id": "ignored_intent", "lane": "exceptions", "col": 3, "type": "security", "label": "Ignore Safely", "sublabel": "locked or invalid target", "width": 158},
    {"id": "rollback_frame", "lane": "exceptions", "col": 5, "type": "backend", "label": "Restore Stable Frame", "sublabel": "cancel / apply failure", "width": 174}
  ],
  "edges": [
    {"id": "sample-route", "from": "pointer_sample", "to": "sparse_route", "label": "screen coordinates", "role": "main", "variant": "emphasis"},
    {"id": "route-intent", "from": "sparse_route", "to": "input_intent", "label": "protected region", "role": "main"},
    {"id": "intent-permission", "from": "input_intent", "to": "permission_gate", "role": "main"},
    {"id": "permission-prepare", "from": "permission_gate", "to": "prepare_frame", "label": "allowed", "role": "main", "variant": "emphasis"},
    {"id": "prepare-submit", "from": "prepare_frame", "to": "atomic_submit", "label": "complete frame", "role": "main", "variant": "emphasis"},
    {"id": "submit-commit", "from": "atomic_submit", "to": "geometry_commit", "label": "pointer release", "role": "main"},
    {"id": "commit-state", "from": "geometry_commit", "to": "sqlite_state", "label": "V3-04 revision / CAS", "role": "async", "variant": "dashed"},
    {"id": "route-explorer", "from": "sparse_route", "to": "explorer_receives", "label": "blank area", "role": "branch", "variant": "dashed"},
    {"id": "permission-ignore", "from": "permission_gate", "to": "ignored_intent", "label": "denied", "role": "error", "variant": "security"},
    {"id": "submit-rollback", "from": "atomic_submit", "to": "rollback_frame", "label": "cancel / failure", "role": "error", "variant": "security"},
    {"id": "rollback-prepare", "from": "rollback_frame", "to": "prepare_frame", "label": "last stable geometry", "role": "return", "variant": "dashed"}
  ]
}
