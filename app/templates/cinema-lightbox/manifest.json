{
  "$schema": "https://desktop-up.app/schemas/template-manifest-v1.json",
  "template_key": "cinema-lightbox",
  "name": "Cinema Lightbox",
  "version": "1.0.0",
  "author": "Desktop-Up Built-in",
  "description": "电影灯箱风格的暖白发光海报",
  "trust_level": "builtin",
  "depth0": {
    "presets": [
      { "id": "lightbox-warm", "name": "暖白灯箱", "thumbnail": "presets/lightbox-warm.png" },
      { "id": "lightbox-cool", "name": "冷白展厅", "thumbnail": "presets/lightbox-cool.png" },
      { "id": "lightbox-gold", "name": "金色大厅", "thumbnail": "presets/lightbox-gold.png" }
    ]
  },
  "depth2": {
    "slots": [
      { "id": "bg", "label": "背景", "type": "image", "accept": ["png","jpg","webp"], "max_size_bytes": 2097152, "default_asset": "assets/bg.png" },
      { "id": "border-overlay", "label": "海报装饰", "type": "svg", "accept": ["svg"], "max_size_bytes": 204800, "default_asset": "assets/border-overlay.svg" }
    ]
  },
  "depth3": {
    "css_allowed": true,
    "html_slots": ["title", "status"],
    "script_allowed": false,
    "description": "Cinema Lightbox 不支持代码脚本。"
  }
}
