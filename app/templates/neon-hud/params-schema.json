      { "key": "--tpl-title-size", "label": "标题字号", "type": "pixel", "min": 20, "max": 48, "default": 28, "cssTransform": "v => v + 'px'" },
      { "key": "--tpl-icon-gap", "label": "图标间距", "type": "pixel", "min": 8, "max": 32, "default": 12, "cssTransform": "v => v + 'px'" },
      { "key": "--tpl-icon-base-size", "label": "图标基准大小", "type": "pixel", "min": 48, "max": 96, "default": 64, "cssTransform": "v => v + 'px'" }
