  },
  {
    "id": "background",
    "label": "背景",
    "params": [
      { "key": "--tpl-bg-darkness", "label": "背景暗度", "type": "percent", "min": 0, "max": 30, "default": 10, "cssTransform": "v => v / 100" },
      { "key": "--tpl-blur-radius", "label": "模糊半径", "type": "pixel", "min": 0, "max": 48, "default": 24, "cssProperty": "--tpl-blur-radius", "cssTransform": "v => v + 'px'" },
      { "key": "--tpl-scanline-opacity", "label": "扫描线不透明度", "type": "percent", "min": 0, "max": 40, "default": 15, "cssTransform": "v => v / 100" }
