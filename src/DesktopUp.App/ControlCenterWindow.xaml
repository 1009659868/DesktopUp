<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DesktopUp.ControlCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DesktopUp · 控制中心">
 <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="DesktopUp" FontSize="24" FontWeight="SemiBold"/>
  <Grid Grid.Row="1" ColumnSpacing="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="CatalogCountText" Text="海报" FontWeight="SemiBold"/>
    <Button Grid.Row="1" x:Name="CreatePosterButton" Content="＋ 新增海报" Click="CreatePoster_Click" AutomationProperties.AutomationId="CreatePoster"/>
    <ListView Grid.Row="2" x:Name="PosterSelector" SelectionMode="Single" SelectionChanged="PosterSelector_SelectionChanged" AutomationProperties.AutomationId="PosterSelector" AutomationProperties.Name="海报列表">
     <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,8" Spacing="4" AutomationProperties.Name="{Binding AccessibleName}">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
   <Grid Grid.Column="1" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PosterTitleText" Text="请选择海报" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SelectedPosterTitle"/>
     <Button Grid.Column="1" x:Name="LocateButton" Content="◎ 定位" Click="Locate_Click" AutomationProperties.AutomationId="LocatePoster"/>
     <DropDownButton Grid.Column="2" x:Name="MoreActionsButton" Content="更多" AutomationProperties.AutomationId="ControlCenterMore"><DropDownButton.Flyout><MenuFlyout>
      <MenuFlyoutItem x:Name="RenamePosterButton" Text="重命名…" Click="RenamePoster_Click" AutomationProperties.AutomationId="RenamePoster"/>
      <MenuFlyoutItem x:Name="ClonePosterButton" Text="复制配置…" Click="ClonePoster_Click" AutomationProperties.AutomationId="ClonePoster"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem x:Name="RemoveButton" Text="删除海报…" Click="RemoveButton_Click" AutomationProperties.AutomationId="RemovePoster"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutSubItem x:Name="PortableProfileMenu" Text="配置与恢复（全局）" AutomationProperties.AutomationId="PortableProfileMenu">
       <MenuFlyoutItem Text="导出习惯配置…" Click="PortableExport_Click" AutomationProperties.AutomationId="PortableExport"/>
       <MenuFlyoutItem Text="导入习惯配置…" Click="PortableImport_Click" AutomationProperties.AutomationId="PortableImport"/>
       <MenuFlyoutItem Text="等待安置／重试…" Click="PortablePending_Click" AutomationProperties.AutomationId="PortablePending"/>
       <MenuFlyoutSeparator/>
       <MenuFlyoutItem Text="创建本机备份" Click="PortableBackup_Click" AutomationProperties.AutomationId="PortableBackup"/>
       <MenuFlyoutItem Text="从本机备份恢复…" Click="PortableRecovery_Click" AutomationProperties.AutomationId="PortableRecovery"/>
      </MenuFlyoutSubItem>
     </MenuFlyout></DropDownButton.Flyout></DropDownButton>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="LockButton" Click="LockButton_Click" Content="锁定" AutomationProperties.AutomationId="LockPoster"/>
      <Button x:Name="CollapseButton" Click="CollapseButton_Click" Content="收起" AutomationProperties.AutomationId="CollapsePoster"/>
      <Button x:Name="VisibilityButton" Click="VisibilityButton_Click" Content="隐藏" AutomationProperties.AutomationId="VisibilityPoster"/>
     </StackPanel>
     <TextBlock x:Name="LocateNotice" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
    </StackPanel>
    <InfoBar Grid.Row="2" x:Name="StateInfoBar" IsOpen="False" IsClosable="False"/>
    <Pivot Grid.Row="3" x:Name="SettingsTabs">
     <PivotItem Header="外观"><ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="AppearanceSection" Spacing="16" Padding="0,8,12,16">
       <TextBlock Text="调整当前海报的整体观感" FontWeight="SemiBold"/>
       <StackPanel x:Name="TemplateSection"/>
       <StackPanel x:Name="ScaleHost" Spacing="0" Width="320" HorizontalAlignment="Left">
        <TextBlock x:Name="ScaleLabel" Text="内容尺度"/>
        <Grid>
         <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.5" StepFrequency="0.01" TickPlacement="None" AutomationProperties.AutomationId="ContentScale" AutomationProperties.Name="内容尺度" AutomationProperties.HelpText="小0.8，标准1，大1.5；点击轨道标记选择预设，拖动或方向键细调。"/>
         <Canvas x:Name="ScaleMarks" IsHitTestVisible="False"/>
        </Grid>
        <Canvas x:Name="ScaleLabels" Height="20" IsHitTestVisible="False"/>
       </StackPanel>
       <StackPanel x:Name="SpacingHost" Spacing="0" Width="320" HorizontalAlignment="Left">
        <TextBlock x:Name="SpacingLabel" Text="内容疏密"/>
        <Grid>
         <Slider x:Name="SpacingSlider" Minimum="0.5" Maximum="1.5" StepFrequency="0.01" TickPlacement="None" AutomationProperties.AutomationId="ContentSpacing" AutomationProperties.Name="内容疏密" AutomationProperties.HelpText="紧凑0.5，标准1，宽松1.5；点击轨道标记选择预设，拖动或方向键细调。"/>
         <Canvas x:Name="SpacingMarks" IsHitTestVisible="False"/>
        </Grid>
        <Canvas x:Name="SpacingLabels" Height="20" IsHitTestVisible="False"/>
       </StackPanel>
       <TextBlock Text="滑动即时预览，松手自动保存。只调整当前海报；未来热度层级与排序保持独立。" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
       <TextBlock x:Name="CommonSettingsNotice" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
     </ScrollViewer></PivotItem>
     <PivotItem Header="行为"><ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18" Padding="0,8,12,16">
       <ToggleSwitch x:Name="AutoPostureSwitch" Header="指针进入展开，离开后收起" OnContent="开启" OffContent="关闭" Toggled="AutoPosture_Changed" AutomationProperties.AutomationId="AutoPostureEnabled"/>
       <NumberBox x:Name="AutoPostureDelay" Header="离开后延迟（秒）" Minimum="1" Maximum="300" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Inline" ValidationMode="Disabled" Width="210" HorizontalAlignment="Left" ValueChanged="AutoPostureDelay_Changed" AutomationProperties.AutomationId="AutoPostureDelay"/>
       <TextBlock Text="开关立即保存；延迟输入完成后自动保存。手动收起后，须离开并重新进入才会自动展开。" Opacity="0.65" TextWrapping="Wrap"/>
       <InfoBar x:Name="AutoPostureInfo" IsOpen="False" IsClosable="False" AutomationProperties.AutomationId="AutoPostureNotice"/>
       <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
       <TextBlock Text="全局 · 全部海报" FontWeight="SemiBold"/>
       <TextBlock x:Name="SettingsDetailText" TextWrapping="Wrap" FontSize="12"/>
       <Button x:Name="PauseButton" Click="PauseButton_Click" Content="暂停动态效果"/>
      </StackPanel>
     </ScrollViewer></PivotItem>
     <PivotItem Header="高级"><ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Padding="0,8,12,16">
       <TextBlock Text="位置和尺寸建议直接在桌面拖动调整。以下用于精确编辑；成组改动仍需确认一次。" TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
       <StackPanel x:Name="EditorSections" Spacing="12"/>
       <Expander Header="运行信息" HorizontalAlignment="Stretch"><StackPanel Spacing="6">
        <TextBlock x:Name="PosterIdentityText" FontSize="11" TextWrapping="Wrap" AutomationProperties.AutomationId="SelectedPosterId"/>
        <TextBlock x:Name="RevisionText" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock x:Name="PosterDetailText" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="RuntimeDetailText" FontSize="12" TextWrapping="Wrap"/>
        <TextBlock x:Name="PresentationDetailText" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="PresentationParameters"/>
       </StackPanel></Expander>
      </StackPanel>
     </ScrollViewer></PivotItem>
     <PivotItem Header="内容布局"><ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="ContentLayoutHost" HorizontalContentAlignment="Stretch"><StackPanel x:Name="ContentLayoutPanel" Spacing="12" Padding="0,8,12,16">
       <TextBlock Text="跨格排版 · DEMO 内容" FontWeight="SemiBold"/>
       <TextBlock x:Name="ContentLayoutStatus" TextWrapping="Wrap" FontSize="12"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ContentEditToggle" Content="在海报上编辑" Click="ContentEditToggle_Click"/>
        <Button Content="进入手动排版" Click="ContentManual_Click"/>
        <DropDownButton Content="退出手动…"><DropDownButton.Flyout><MenuFlyout>
         <MenuFlyoutItem Text="保留当前顺序" Tag="KeepOrder" Click="ContentExitManual_Click"/>
         <MenuFlyoutItem Text="转为顺序锚" Tag="ConvertToAnchors" Click="ContentExitManual_Click"/>
         <MenuFlyoutItem Text="恢复自动排列" Tag="RestoreAutomatic" Click="ContentExitManual_Click"/>
        </MenuFlyout></DropDownButton.Flyout></DropDownButton>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="18">
        <CheckBox x:Name="ContentGridSwitch" Content="基线网格" Checked="ContentGuides_Changed" Unchecked="ContentGuides_Changed"/>
        <CheckBox x:Name="ContentSpanSwitch" Content="跨度提示" Checked="ContentGuides_Changed" Unchecked="ContentGuides_Changed"/>
       </StackPanel>
       <ComboBox x:Name="ContentItemSelector" Header="所选卡片" Width="320" HorizontalAlignment="Left" SelectionChanged="ContentItem_Changed" DisplayMemberPath="Name"/>
       <StackPanel Orientation="Horizontal" Spacing="10">
        <NumberBox x:Name="ContentColumns" Header="列跨度" Minimum="1" Maximum="32" SmallChange="1" Width="140" SpinButtonPlacementMode="Inline" ValueChanged="ContentSpan_Changed"/>
        <NumberBox x:Name="ContentRows" Header="行跨度" Minimum="1" Maximum="32" SmallChange="1" Width="140" SpinButtonPlacementMode="Inline" ValueChanged="ContentSpan_Changed"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="方卡 4×4" Tag="square" Click="ContentPreset_Click"/>
        <Button Content="横幅 8×4" Tag="wide" Click="ContentPreset_Click"/>
        <Button Content="竖卡 4×6" Tag="tall" Click="ContentPreset_Click"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ContentFixedButton" Content="固定位置" Click="ContentFixed_Click"/>
        <Button Content="恢复自动尺寸" Click="ContentAutoSize_Click"/>
        <Button Content="撤销" Tag="undo" Click="ContentUndo_Click"/>
        <Button Content="重做" Tag="redo" Click="ContentUndo_Click"/>
       </StackPanel>
       <Button x:Name="ContentKeyboardPad" Content="键盘编辑：方向键移动 · Shift＋方向键改跨度" KeyDown="ContentKeyboard_KeyDown" HorizontalAlignment="Left"/>
       <TextBlock Text="先进入手动排版或固定卡片，再拖动内容；右下角把手改跨度。滚轮连续滚动，Shift＋滚轮横向滚动。鼠标拖动时 Esc 取消；每次完成自动保存。" TextWrapping="Wrap" FontSize="12" Opacity="0.65"/>
       <Expander Header="DEMO 参考构图" HorizontalAlignment="Stretch"><StackPanel Spacing="8">
        <TextBlock Text="仅替换演示排版，不操作实际文件；可撤销。重启保留修改。" TextWrapping="Wrap" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Content="等尺寸" Tag="equal" Click="ContentSample_Click"/>
         <Button Content="插画墙" Tag="illustration" Click="ContentSample_Click"/>
         <Button Content="封面墙" Tag="covers" Click="ContentSample_Click"/>
         <Button Content="横版混排" Tag="landscape" Click="ContentSample_Click"/>
        </StackPanel>
       </StackPanel></Expander>
       <TextBlock x:Name="ContentLayoutNotice" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel></ContentControl>
     </ScrollViewer></PivotItem>
    </Pivot>
   </Grid>
  </Grid>
 </Grid>
</Window>
