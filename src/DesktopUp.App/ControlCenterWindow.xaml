<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DesktopUp.ControlCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DesktopUp V3">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="DesktopUp V3" />
            <TextBlock Text="海报共享一个状态库；在左侧选择要管理的海报。" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CatalogCountText" Text="海报" FontWeight="SemiBold" />
                <ListView x:Name="PosterSelector" Grid.Row="1" SelectionMode="Single"
                          AutomationProperties.AutomationId="PosterSelector"
                          AutomationProperties.Name="海报列表"
                          SelectionChanged="PosterSelector_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,8" Spacing="4" AutomationProperties.Name="{Binding AccessibleName}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <InfoBar x:Name="StateInfoBar" IsOpen="True" IsClosable="False"
                             Severity="Informational" Title="状态正在初始化" Message="等待已提交海报目录。" />
                    <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="PosterTitleText" FontSize="22" FontWeight="SemiBold" Text="请选择海报"
                                       AutomationProperties.AutomationId="SelectedPosterTitle" TextWrapping="Wrap" />
                            <TextBlock x:Name="PosterIdentityText" Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SelectedPosterId" />
                            <TextBlock x:Name="RevisionText" Opacity="0.7" Text="committed revision —" TextWrapping="Wrap" />
                            <TextBlock x:Name="PosterDetailText" Text="等待状态投影。" TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeDetailText" TextWrapping="Wrap" />
                            <TextBlock x:Name="PresentationDetailText" TextWrapping="Wrap" Opacity="0.75"
                                       AutomationProperties.AutomationId="PresentationParameters" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="LockButton" Click="LockButton_Click" Content="锁定" IsEnabled="False"
                                        AutomationProperties.AutomationId="LockPoster" />
                                <Button x:Name="CollapseButton" Click="CollapseButton_Click" Content="收起" IsEnabled="False"
                                        AutomationProperties.AutomationId="CollapsePoster" />
                                <Button x:Name="VisibilityButton" Click="VisibilityButton_Click" Content="隐藏" IsEnabled="False"
                                        AutomationProperties.AutomationId="VisibilityPoster" />
                                <Button x:Name="RemoveButton" Click="RemoveButton_Click" Content="删除海报…" IsEnabled="False"
                                        AutomationProperties.AutomationId="RemovePoster" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="AutoPostureHeading" Text="自动收展 · 仅所选海报" FontWeight="SemiBold" />
                            <ToggleSwitch x:Name="AutoPostureSwitch" Header="指针进入时展开，离开后收起"
                                          OnContent="开启" OffContent="关闭" IsEnabled="False" Toggled="AutoPosture_Changed"
                                          AutomationProperties.AutomationId="AutoPostureEnabled" />
                            <TextBox x:Name="AutoPostureDelay" Header="离开后收起的延迟（秒）" PlaceholderText="1～300"
                                     MaxLength="10" MaxWidth="260" HorizontalAlignment="Left" IsEnabled="False"
                                     TextChanging="AutoPostureDelay_Changing" TextChanged="AutoPostureDelay_Changed"
                                     AutomationProperties.AutomationId="AutoPostureDelay" />
                            <TextBlock Text="默认关闭，延迟为 1～300 的整数秒数，默认 3 秒；不是动画时长。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock Text="修改后需应用；切换海报或关闭窗口会丢弃未应用的修改。编辑期间暂停自动收展。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                            <InfoBar x:Name="AutoPostureInfo" IsOpen="True" IsClosable="False"
                                     AutomationProperties.AutomationId="AutoPostureNotice" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AutoPostureApply" Content="应用" IsEnabled="False" Click="AutoPostureApply_Click"
                                        AutomationProperties.AutomationId="ApplyAutoPosture" />
                                <Button x:Name="AutoPostureCancel" Content="取消" IsEnabled="False" Click="AutoPostureCancel_Click"
                                        AutomationProperties.AutomationId="CancelAutoPosture" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="全局设置（作用于全部海报）" FontWeight="SemiBold" />
                    <TextBlock x:Name="SettingsDetailText" Text="设置尚未就绪。" TextWrapping="Wrap" />
                    <Button x:Name="PauseButton" Click="PauseButton_Click" Content="暂停动态效果" IsEnabled="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
