<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DesktopUp</RootNamespace>
    <AssemblyName>DesktopUp</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DesktopUpPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);DESKTOPUP_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopUp.Application\DesktopUp.Application.csproj" />
    <ProjectReference Include="..\DesktopUp.Domain\DesktopUp.Domain.csproj" />
    <ProjectReference Include="..\DesktopUp.Infrastructure\DesktopUp.Infrastructure.csproj" />
    <ProjectReference Include="..\DesktopUp.Windows\DesktopUp.Windows.csproj" />
    <ProjectReference Include="..\DesktopUp.ContentWorker\DesktopUp.ContentWorker.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
  </ItemGroup>
  <!-- WinUI 2.3.6 concatenates OutputPath + XAML filename when preparing XBF/PRI.
       A CLI -o path without a trailing slash silently creates wrong resource names. -->
  <Target Name="ValidateWinUiOutputPath" BeforeTargets="PrepareForBuild;Prep_ComputeProcessXamlFiles">
    <Error Condition="'$(OutputPath)' != '' and !HasTrailingSlash('$(OutputPath)')"
           Code="DUV3001"
           Text="WinUI OutputPath must end in a directory separator to preserve XBF resource names. Use scripts/build.ps1 -OutputDirectory or append a slash to dotnet build -o." />
  </Target>
  <ItemGroup>
    <Content Include="../../config/poster-animation.json" Link="config/poster-animation.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Dedicated Shell helper follows every build/publish entry, not just one review script. -->
  <Target Name="CopyContentWorker" AfterTargets="Build">
    <MSBuild Projects="../DesktopUp.ContentWorker/DesktopUp.ContentWorker.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="OutputPath;OutDir;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="_ContentWorkerTarget" />
    </MSBuild>
    <PropertyGroup><_ContentWorkerDirectory>@(_ContentWorkerTarget->'%(RootDir)%(Directory)')</_ContentWorkerDirectory></PropertyGroup>
    <ItemGroup>
      <_ContentWorkerFiles Include="$(_ContentWorkerDirectory)*" Exclude="$(_ContentWorkerDirectory)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_ContentWorkerFiles)" DestinationFolder="$(TargetDir)content-worker" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishContentWorker" AfterTargets="Publish">
    <MSBuild Projects="../DesktopUp.ContentWorker/DesktopUp.ContentWorker.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);Platform=$(Platform);SelfContained=$(SelfContained);PublishDir=$(PublishDir)content-worker/;DesktopUpPreviewRuntimeVersion=$(DesktopUpPreviewRuntimeVersion)"
             RemoveProperties="OutputPath;OutDir;PublishProfile;WindowsAppSDKSelfContained" />
  </Target>
</Project>
