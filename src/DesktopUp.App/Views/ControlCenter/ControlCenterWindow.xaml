      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#DED3C1"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#EEE9DF"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#755023"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#755023"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#5C3D19"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#8D8375"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#BDA789"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#755023"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#755023"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="#CBC8C1"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="ButtonBackground" Color="#2A2D30"/>
      <SolidColorBrush x:Key="ButtonForeground" Color="#F3F4F0"/>
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4A4D4E"/>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#323538"/>
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3F4F0"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4A4D4E"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3B3D40"/>
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F3F4F0"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4A4D4E"/>
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2A2D30"/>
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#959692"/>
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#4A4D4E"/>
      <SolidColorBrush x:Key="DropDownButtonForegroundSecondary" Color="#F3F4F0"/>
      <SolidColorBrush x:Key="DropDownButtonForegroundSecondaryPointerOver" Color="#F3F4F0"/>
      <SolidColorBrush x:Key="DropDownButtonForegroundSecondaryPressed" Color="#F3F4F0"/>
      <SolidColorBrush x:Key="UiCPanelBrush" Color="#202326"/>
      <SolidColorBrush x:Key="UiCSidebarBrush" Color="#191C1F"/>
      <SolidColorBrush x:Key="UiCFolderBrush" Color="#2A2927"/>
      <SolidColorBrush x:Key="UiCBorderBrush" Color="#45494B"/>
      <SolidColorBrush x:Key="UiCAccentBrush" Color="#E9B871"/>
      <SolidColorBrush x:Key="UiCTextBrush" Color="#EBECE9"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2A2927"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#39332A"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#443A2C"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2927"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E9B871"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#F2C88C"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F2C88C"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#938673"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#8E7453"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#E9B871"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#E9B871"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="#45494B"/>
     </ResourceDictionary>
     <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}"/>
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="DropDownButtonForegroundSecondary" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="DropDownButtonForegroundSecondaryPointerOver" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="DropDownButtonForegroundSecondaryPressed" Color="{ThemeResource SystemColorButtonTextColor}"/>
      <SolidColorBrush x:Key="UiCPanelBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="UiCSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="UiCFolderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="UiCBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="UiCAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="UiCTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
     </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource UiCTextBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="UiCButton" TargetType="Button"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="{ThemeResource UiCFolderBrush}"/><Setter Property="Foreground" Value="{ThemeResource UiCTextBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource UiCBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource UiCButton}"/>
    <Style x:Key="UiCAction" TargetType="Button" BasedOn="{StaticResource UiCButton}"/>
    <Style x:Key="UiCColorAction" TargetType="Button" BasedOn="{StaticResource UiCButton}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Width" Value="148"/></Style>
    <Style x:Key="UiCAppearanceCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource UiCPanelBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style x:Key="UiCAppearanceFolder" TargetType="Expander"><Setter Property="MinHeight" Value="58"/><Setter Property="Padding" Value="16,0,16,14"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style x:Key="UiCDropDown" TargetType="DropDownButton" BasedOn="{StaticResource UiCButton}"/>
    <Style TargetType="TextBox"><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="{ThemeResource UiCFolderBrush}"/><Setter Property="Foreground" Value="{ThemeResource UiCTextBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource UiCBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="{ThemeResource UiCFolderBrush}"/><Setter Property="Foreground" Value="{ThemeResource UiCTextBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource UiCBorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="Expander"><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource UiCBorderBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource UiCTextBrush}"/></Style>
    <Style TargetType="ToggleSwitch"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource UiCTextBrush}"/></Style>
    <Style x:Key="UiCChoice" TargetType="ToggleButton"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="28"/></Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Border x:Name="UiCPaperSurface" Background="{ThemeResource UiCPanelBrush}" IsHitTestVisible="False"/>
  <Grid x:Name="UiCBody">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="UiCSidebarColumn" Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="UiCSidebarRow" Height="*"/><RowDefinition x:Name="UiCInspectorRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="UiCSidebar" Background="{ThemeResource UiCSidebarBrush}" BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="0,0,1,0" Padding="10,22,10,12">
    <Grid x:Name="UiCSidebarPanel" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="CatalogCountText" Text="海报" FontSize="11" Opacity="0.7" Margin="6,0"/>
     <Button Grid.Row="1" x:Name="CreatePosterButton" Content="＋ 新增海报" Click="CreatePoster_Click" HorizontalAlignment="Stretch" Style="{StaticResource UiCAction}" AutomationProperties.AutomationId="CreatePoster"/>
     <ListView Grid.Row="2" x:Name="PosterSelector" SelectionMode="Single" SelectionChanged="PosterSelector_SelectionChanged" AutomationProperties.AutomationId="PosterSelector" AutomationProperties.Name="海报列表">
      <ListView.ItemTemplate><DataTemplate><Grid Padding="0,7" ColumnSpacing="9" AutomationProperties.Name="{Binding AccessibleName}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Height="29" Background="{ThemeResource UiCFolderBrush}" BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Top"><StackPanel Spacing="3" Margin="4,5"><Border Height="3" Background="{ThemeResource UiCAccentBrush}"/><Border Height="8" Background="{ThemeResource UiCAccentBrush}" Opacity="0.35"/></StackPanel></Border>
       <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" FontSize="10" Opacity="0.6" TextWrapping="Wrap"/></StackPanel>
      </Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <Grid Grid.Column="1" x:Name="UiCInspector" Margin="25,22,24,12" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="3"><TextBlock x:Name="PosterTitleText" Text="请选择海报" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SelectedPosterTitle"/><TextBlock Text="当前海报" FontSize="10" Opacity="0.6"/></StackPanel>
     <Button Grid.Column="1" x:Name="LocateButton" Content="◎" Click="Locate_Click" Style="{StaticResource UiCAction}" AutomationProperties.AutomationId="LocatePoster" AutomationProperties.Name="定位海报" ToolTipService.ToolTip="在桌面定位当前海报"/>
<DropDownButton Grid.Column="2" x:Name="MoreActionsButton" Content="更多" Style="{StaticResource UiCDropDown}" FontSize="12" Padding="9,5" AutomationProperties.AutomationId="ControlCenterMore"><DropDownButton.Flyout><MenuFlyout>
      <MenuFlyoutItem x:Name="RenamePosterButton" Text="重命名…" Click="RenamePoster_Click" AutomationProperties.AutomationId="RenamePoster"/>
      <MenuFlyoutItem x:Name="ClonePosterButton" Text="复制配置…" Click="ClonePoster_Click" AutomationProperties.AutomationId="ClonePoster"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem x:Name="RemoveButton" Text="删除海报…" Click="RemoveButton_Click" AutomationProperties.AutomationId="RemovePoster"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutSubItem x:Name="PortableProfileMenu" Text="配置与恢复（全局）" AutomationProperties.AutomationId="PortableProfileMenu">
       <MenuFlyoutItem Text="导出习惯配置…" Click="PortableExport_Click" AutomationProperties.AutomationId="PortableExport"/>
       <MenuFlyoutItem Text="导入习惯配置…" Click="PortableImport_Click" AutomationProperties.AutomationId="PortableImport"/>
       <MenuFlyoutItem Text="等待安置／重试…" Click="PortablePending_Click" AutomationProperties.AutomationId="PortablePending"/>
       <MenuFlyoutSeparator/>
       <MenuFlyoutItem Text="创建本机备份" Click="PortableBackup_Click" AutomationProperties.AutomationId="PortableBackup"/>
       <MenuFlyoutItem Text="从本机备份恢复…" Click="PortableRecovery_Click" AutomationProperties.AutomationId="PortableRecovery"/>
       <MenuFlyoutSeparator/>
       <MenuFlyoutItem x:Name="TransferRecoveryMenu" Text="异常文件位置…" Visibility="Collapsed" Click="TransferRecovery_Click" AutomationProperties.AutomationId="TransferRecovery"/>
      </MenuFlyoutSubItem>
     </MenuFlyout></DropDownButton.Flyout></DropDownButton>
    </Grid>
    <TextBlock Grid.Row="1" x:Name="LocateNotice" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
    <InfoBar Grid.Row="2" x:Name="StateInfoBar" IsOpen="False" IsClosable="False"/>
    <Grid Grid.Row="3" x:Name="SettingsTabs" RowSpacing="13"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="0,0,0,1" Padding="0,5,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.Resources>
       <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
       <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent"/>
       <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent"/>
       <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent"/>
      </Grid.Resources>
      <StackPanel Orientation="Horizontal" Spacing="9"><ToggleButton x:Name="AppearanceTab" Content="外观" Tag="appearance" IsChecked="True" Click="WorkspaceTab_Click" Style="{StaticResource UiCChoice}"/><ToggleButton x:Name="BehaviorTab" Content="行为" Tag="behavior" Click="WorkspaceTab_Click" Style="{StaticResource UiCChoice}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
   <Button x:Name="UiCThemeButton" Content="◧ 主题 ⌄" Click="Theme_Click" Style="{StaticResource UiCAction}" AutomationProperties.AutomationId="CenterTheme" ToolTipService.ToolTip="更换控制中心的颜色，不影响海报样式。"/>
   <DropDownButton x:Name="UiCGlobalSettings" Content="全局" Style="{StaticResource UiCDropDown}" FontSize="11" Padding="8,5">
    <DropDownButton.Flyout><Flyout><StackPanel x:Name="UiCGlobalPanel" Spacing="12" Width="260">
     <TextBlock Text="全局 · 全部海报" FontWeight="SemiBold"/><TextBlock x:Name="SettingsDetailText" TextWrapping="Wrap"/>
     <Button x:Name="PauseButton" Click="PauseButton_Click" Content="暂停提示动效" Style="{StaticResource UiCAction}"/>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="收纳位置" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="查看 / 更改…" Click="ManagedStorage_Click" Style="{StaticResource UiCAction}"/>
     </Grid>
     <ToggleSwitch x:Name="StartupToggle" Header="开机自启动" OnContent="已登记" OffContent="未登记" IsEnabled="False" Toggled="StartupToggle_Toggled" AutomationProperties.AutomationId="LaunchAtStartup"/>
     <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
     <HyperlinkButton Content="Windows 启动应用" Click="StartupSettings_Click" Padding="0"/>
    </StackPanel></Flyout></DropDownButton.Flyout>
   </DropDownButton>
   </StackPanel>
     </Grid>
     <ScrollViewer Grid.Row="1" x:Name="AppearanceScroll" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel x:Name="AppearanceSection" Spacing="17" Padding="0,0,8,12">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="海报模板" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" x:Name="TemplateActionsHost" Orientation="Horizontal" Spacing="14"/>
       </Grid>
       <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="1" Background="{ThemeResource UiCFolderBrush}" BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="1" CornerRadius="0,12,10,10">
        <Expander x:Name="UiCTemplateFolder" IsExpanded="False" MinHeight="48" Padding="14,2,14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="0" CornerRadius="0,12,10,10" AutomationProperties.AutomationId="TemplateFolder" AutomationProperties.Name="海报模板样片夹">
         <Expander.Resources>
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/><SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
          <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent"/><SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent"/>
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/><SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
         </Expander.Resources>
         <Expander.Header><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="当前样片" FontSize="10" Opacity="0.65" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="UiCTemplateSummary" Text="请选择海报" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" x:Name="UiCFolderAction" Text="展开样片" FontSize="10" Opacity="0.65" VerticalAlignment="Center"/></Grid></Expander.Header>
         <StackPanel Spacing="12">
          <Grid x:Name="TemplateSampleDeck" ColumnSpacing="13" Margin="3,10,3,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
          <Grid Padding="0,9,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource UiCBorderBrush}" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="TemplatePrevious" Content="←" Click="TemplatePrevious_Click" Style="{StaticResource UiCAction}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="翻看上一组模板"/><TextBlock x:Name="TemplateSampleRange" Text="1–3 / 3" FontFamily="Consolas" FontSize="11" Opacity="0.75" VerticalAlignment="Center"/><Button x:Name="TemplateNext" Content="→" Click="TemplateNext_Click" Style="{StaticResource UiCAction}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="翻看下一组模板"/></StackPanel>
           <StackPanel Grid.Column="1" x:Name="TemplateLibraryActionsHost" Orientation="Horizontal" Spacing="12"/>
          </Grid>
          <StackPanel x:Name="TemplateComponentsSection" Spacing="8"/>
          <StackPanel x:Name="TemplateSection"/>
         </StackPanel>
        </Expander>
        </Border>
        <Border VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="0,0,0,-1" Padding="15,2,15,3" Background="{ThemeResource UiCFolderBrush}" BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="7,8,0,0" IsHitTestVisible="False"><TextBlock x:Name="UiCFolderTab" Text="样片夹" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource UiCAccentBrush}"/></Border>
       </Grid>
       <ContentControl x:Name="ContentLayoutHost" HorizontalContentAlignment="Stretch"><StackPanel x:Name="ContentLayoutPanel" Spacing="12">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="1" Background="{ThemeResource UiCFolderBrush}" BorderBrush="{ThemeResource UiCBorderBrush}" BorderThickness="1" CornerRadius="0,12,10,10">
         <Expander x:Name="LayoutFolder" IsExpanded="False" MinHeight="56" Padding="14,2,14,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" CornerRadius="0,12,10,10" AutomationProperties.AutomationId="LayoutFolder" AutomationProperties.Name="外观与布局" ToolTipService.ToolTip="背景、标题、内容尺度与排布；折叠不会重置设置。">
          <Expander.Header><StackPanel Spacing="2"><TextBlock Text="外观与布局" FontWeight="SemiBold"/><TextBlock Text="仅当前海报" FontSize="10" Opacity="0.65"/></StackPanel></Expander.Header>
          <Expander.Resources>
           <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/><SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
           <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent"/><SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent"/>
           <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/><SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
          </Expander.Resources>
          <StackPanel x:Name="LayoutFolderPanel" Spacing="14">
       <Border x:Name="SurfaceCard" Style="{StaticResource UiCAppearanceCard}">
       <Expander x:Name="SurfaceFolder" Style="{StaticResource UiCAppearanceFolder}" IsExpanded="False" AutomationProperties.Name="海报背景">
        <Expander.Header><StackPanel Spacing="3"><TextBlock Text="海报背景" FontWeight="SemiBold"/><TextBlock x:Name="SurfaceSummary" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/></StackPanel></Expander.Header>
        <StackPanel Spacing="8">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="背景颜色" VerticalAlignment="Center" TextWrapping="Wrap"/>
