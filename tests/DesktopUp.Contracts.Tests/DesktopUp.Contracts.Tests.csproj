<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DesktopUp.Setup/DesktopUp.Setup.csproj" />
    <ProjectReference Include="..\..\src\DesktopUp.Application\DesktopUp.Application.csproj" />
    <ProjectReference Include="../../src/DesktopUp.ContentWorker/DesktopUp.ContentWorker.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
    <ProjectReference Include="../DesktopUp.ContentFixture/DesktopUp.ContentFixture.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
    <ProjectReference Include="../DesktopUp.TransferFixture/DesktopUp.TransferFixture.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
    <ProjectReference Include="..\..\src\DesktopUp.Domain\DesktopUp.Domain.csproj" />
    <ProjectReference Include="..\..\src\DesktopUp.Infrastructure\DesktopUp.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DesktopUp.Windows\DesktopUp.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../Shared/DragProbe/*.cs" Link="DragProbe/%(Filename)%(Extension)" />
    <Compile Include="../Shared/MultiPosterFixtureData.cs" Link="MultiPosterFixtureData.cs" />
    <Compile Include="../Shared/MeasurementFixtureData.cs" Link="MeasurementFixtureData.cs" />
    <Compile Include="../../scripts/MeasurementMath.cs" Link="MeasurementMath.cs" />
    <Compile Include="../../scripts/M08MeasurementRules.cs" Link="M08MeasurementRules.cs" />
    <Compile Include="../../src/DesktopUp.App/PresentationReadbackEquality.cs" Link="PresentationReadbackEquality.cs" />
    <Compile Include="../../src/DesktopUp.ContentWorker/ShellIconQuality.cs" Link="ShellIconQuality.cs" />
    <None Include="../../scripts/fixtures/portable-p4-pending.desktopup.json" Link="Fixtures/portable-p4-pending.desktopup.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../packaging/preview/package-settings.json" Link="Fixtures/preview-package-settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyContentTestHelpers" AfterTargets="Build">
    <MSBuild Projects="../../src/DesktopUp.ContentWorker/DesktopUp.ContentWorker.csproj;../DesktopUp.ContentFixture/DesktopUp.ContentFixture.csproj;../DesktopUp.TransferFixture/DesktopUp.TransferFixture.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="OutputPath;OutDir;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="_HelperTargets" />
    </MSBuild>
    <ItemGroup><_HelperFiles Include="%(_HelperTargets.RootDir)%(_HelperTargets.Directory)*" /></ItemGroup>
    <Copy SourceFiles="@(_HelperFiles)" DestinationFolder="$(TargetDir)content-test-helpers" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <Compile Include="../Shared/ContentCreationFixture.cs" Link="Support/ContentCreationFixture.cs" />
    <Compile Include="../Shared/ContentTestServices.cs" Link="Support/ContentTestServices.cs" />
  </ItemGroup>
</Project>
